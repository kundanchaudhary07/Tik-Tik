# ==============================================================================
# Productivity Platform - Environment Variables Reference (.env.example)
#
# SECURITY DIRECTIVE:
# NEVER commit real credentials, database passwords, SMTP app passwords, or
# SECRET_KEY values to version control. Keep .env in .gitignore at all times.
# ==============================================================================

# Runtime Environment (development | test | staging | production)
ENVIRONMENT=development
DEBUG=false

# Application Domain & Host Configuration
APP_URL=http://localhost:3000
API_URL=http://localhost:3000

# PostgreSQL Database Connection
# Local Docker Compose: postgresql://postgres:postgrespassword@db:5432/productivity_db
# AWS RDS Target:       postgresql://<db_user>:<db_pass>@<rds-endpoint>.rds.amazonaws.com:5432/productivity_prod
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/productivity_db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Redis Connection (Queues, Background Jobs & Locks)
# Local Docker Compose: redis://redis:6379/0
# AWS ElastiCache Target: redis://<elasticache-cluster-endpoint>:6379/0
REDIS_URL=redis://localhost:6379/0

# Cryptographic Authentication Secret (Minimum 32 random alphanumeric bytes)
# Generate via: openssl rand -hex 32
SECRET_KEY=

# Initial Bootstrap Administrator (Provisioned once on clean startup)
INITIAL_ADMIN_EMAIL=voidkd05@gmail.com
INITIAL_ADMIN_PASSWORD=89697998

# SMTP Email Delivery Provider (Gmail SMTP, Amazon SES, SendGrid, Postmark)
# Leave blank to use TestEmailProvider in development/test environments
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=voidkd05@gmail.com
SMTP_PASSWORD=jbhi yrzz xivl tgns
SMTP_FROM_EMAIL=voidkd05@gmail.com
SMTP_SECURE=false

# CORS Allowed Origins (Comma-separated or JSON array)
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional AI Features (Managed via Platform Secrets)
GEMINI_API_KEY=
