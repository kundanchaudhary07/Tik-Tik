# ============================================================
# Tik Tik — Environment Variable Template
# ============================================================
# IMPORTANT:
# This file is safe to commit to GitHub.
# NEVER put real passwords, tokens, API keys, or secrets here.
# Put real values in your local .env file instead.
# ============================================================

# Application
ENVIRONMENT=development
DEBUG=false
APP_URL=
API_URL=
PORT=

# PostgreSQL
DATABASE_URL=
DATABASE_SSL=
DB_POOL_SIZE=
DB_MAX_OVERFLOW=
DB_POOL_RECYCLE=
DB_POOL_PRE_PING=

# Redis
REDIS_URL=

# Authentication / Security
SECRET_KEY=

# Initial administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Gmail SMTP
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# CORS
CORS_ORIGINS=

# Email provider selection: smtp for local Gmail or brevo for production
EMAIL_PROVIDER=
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=Tik Tik

# Temporary Twilio SMS connectivity test
TWILIO_ACCOUNT_SID=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_FROM_NUMBER=

# Optional AI integration
GEMINI_API_KEY=
