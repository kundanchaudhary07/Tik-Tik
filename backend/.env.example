# ============================================================
# Tik Tik — Environment Variable Template
# ============================================================
# IMPORTANT:
# This file is safe to commit to GitHub.
# NEVER put real passwords, tokens, API keys, or secrets here.
# Put real values in your local .env file instead.
# ============================================================

# Application
ENVIRONMENT=development
DEBUG=false
APP_URL=http://localhost:3000
API_URL=http://localhost:3000

# PostgreSQL
DATABASE_URL=
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_POOL_PRE_PING=true

# Redis
REDIS_URL=

# Authentication / Security
SECRET_KEY=

# Initial administrator
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_SECURE=false

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Optional AI integration
GEMINI_API_KEY=
