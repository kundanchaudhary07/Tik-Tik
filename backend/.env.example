# Application Environment Configuration
ENVIRONMENT=development
DEBUG=true
PROJECT_NAME="Productivity Platform Learning Lab"
API_V1_STR=/api

# Server Binding
HOST=0.0.0.0
PORT=8001

# PostgreSQL Database Connection
# format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/productivity_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_POOL_RECYCLE=3600

# Authentication & Security
SECRET_KEY=dev_secret_key_change_in_production_super_secure_32_bytes_min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email Verification & Password Reset
TOKEN_EXPIRE_HOURS=24
FRONTEND_URL=http://localhost:3000

# Redis Queue & Background Worker
REDIS_URL=redis://localhost:6379/0

# Email Delivery Configuration (Real Provider)
# Set EMAIL_PROVIDER=smtp for production real email delivery
EMAIL_PROVIDER=smtp
EMAIL_FROM=no-reply@productivityplatform.local
EMAIL_FROM_NAME="Productivity Platform"

# Real SMTP Provider Configuration (e.g. Gmail App Password, AWS SES, SendGrid, Postmark)
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USERNAME=voidkd05@gmail.com
SMTP_PASSWORD=jbhi yrzz xivl tgns
SMTP_USE_TLS=true
SMTP_USE_SSL=false

# Rate Limiting (educational in-memory limit per minute)
AUTH_RATE_LIMIT_PER_MINUTE=10

# CORS
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:8001"]
